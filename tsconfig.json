{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "outDir": "dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["esnext", "webworker"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*.ts"]
}
