{
  "name": "everfall-limited-watcher",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "changelog:generate": "tsx scripts/build-release-notes.ts",
    "build": "npm run changelog:generate && vite build && tsc",
    "lint": "node scripts/check-lockfiles.mjs && tsx scripts/build-release-notes.ts --check && tsc --noEmit",
    "test": "node --test scripts/check-lockfiles.test.mjs && tsx --test src/shared/__tests__/*.test.ts",
    "check:lockfiles": "node scripts/check-lockfiles.mjs && bun install --frozen-lockfile --lockfile-only && npm ci --dry-run --ignore-scripts --no-audit --no-fund",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "npm run changelog:generate && tsx watch src/server.ts",
    "start": "npm run changelog:generate && tsx src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cheerio": "^1.0.0-rc.12",
    "typescript": "^5.4.2",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "@types/jpeg-js": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord-interactions": "^4.4.0",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.8"
  }
}
